# Copy to .env and fill in. Defaults match docker-compose.yml for local development.

# --- Database (three roles, see db/init/00_roles.sql) ---------------------------------------------
DATABASE_URL=postgres://repairdesk_app:app_dev_password@localhost:55432/repairdesk           # web app, RLS enforced
DATABASE_SERVICE_URL=postgres://repairdesk_service:service_dev_password@localhost:55432/repairdesk  # worker/webhooks, bypasses RLS
DATABASE_OWNER_URL=postgres://repairdesk_owner:owner_dev_password@localhost:55432/repairdesk       # migrations only

# --- Platform --------------------------------------------------------------------------------------
PLATFORM_NAME=RepairDesk                 # never shown to customers; used on the platform admin host only
PLATFORM_ROOT_DOMAIN=localhost:3000      # shops live at <slug>.<this>. Production e.g. repairdesk.co.ke (wildcard DNS)
PUBLIC_SCHEME=http                       # https in production
APP_MASTER_KEY=                          # 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTERNAL_CRON_SECRET=                    # protects POST /api/internal/tick (random string)
MOCK_PROVIDER_SECRET=                    # signs the simulated courier's QR codes/OTPs (random string)
MOCK_DELAY_SECONDS=20                    # how fast the simulated rider moves

# --- File storage (S3-compatible: MinIO locally, Cloudflare R2 or AWS S3 in production) -------------
S3_ENDPOINT=http://localhost:59000       # R2: https://<accountid>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=repairdesk-private
S3_ACCESS_KEY=minio_dev
S3_SECRET_KEY=minio_dev_password
S3_FORCE_PATH_STYLE=true                 # true for MinIO, false for AWS/R2

# --- M-Pesa (Safaricom Daraja). Per-shop credentials are set in the shop's Settings; these are the fallback.
MPESA_DRIVER=simulator                   # simulator = fake STK prompt with a "confirm" button on the pay screen; daraja = real API
MPESA_ENV=sandbox                        # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379                   # Daraja sandbox test Paybill
MPESA_PASSKEY=
MPESA_CALLBACK_BASE_URL=                 # public https URL Safaricom can reach, e.g. https://api.yourdomain.co.ke (ngrok in dev)

# --- SMS (Africa's Talking) ------------------------------------------------------------------------
SMS_DRIVER=console                       # console = print to server log; africastalking = real
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=                            # optional registered alphanumeric sender

# --- Email ------------------------------------------------------------------------------------------
EMAIL_DRIVER=console                     # console | smtp
SMTP_URL=                                # smtps://user:pass@smtp.example.com:465
SMTP_FROM=no-reply@example.com

# --- Maps -------------------------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=         # Places autocomplete + map pin. Without it the address form is free-text only.

# --- Development conveniences -----------------------------------------------------------------------
OTP_DEV_CODE=123456                      # when set (non-production only) every OTP is this code
